{
  "name": "quillarium",
  "version": "0.2.2",
  "private": true,
  "description": "Obsidian-backed writing system for long-form fiction with heavy AI assistance.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --filter @quillarium/checks copy:prompts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm test",
    "cli": "tsx packages/cli/src/index.ts",
    "desktop:dev": "pnpm --filter @quillarium/desktop dev",
    "desktop:build": "pnpm --filter @quillarium/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "esbuild@0.28.0": "0.28.1",
      "js-yaml@<3.15.1": "3.15.1",
      "js-yaml@4.1.1": "4.3.1"
    }
  }
}
